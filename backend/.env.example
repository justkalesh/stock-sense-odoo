# Postgres. On Vercel, the Neon integration sets both of these for you.
# DATABASE_URL is the pooled URL (used at runtime); DATABASE_URL_UNPOOLED is the direct URL (used by migrations).
DATABASE_URL="postgres://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgres://USER:PASSWORD@HOST/DB?sslmode=require"

# Local API port (ignored on Vercel)
PORT=4000

# Password-reset emails via Gmail. Needs 2-Step Verification on the account and an App Password:
# https://myaccount.google.com/apppasswords  (16 characters, paste without spaces)
# Leave empty to print codes to the server log instead of emailing them.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Show the reset code on screen (demo fallback when email isn't set up). Never "true" for real users.
EXPOSE_DEV_OTP=false

# Create demo users, warehouses, products and operations on first deploy/seed (skipped once any user exists)
SEED_DEMO=true
